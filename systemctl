#!/bin/sh

ACTION="$1"
SERVICE="$2"
API="127.0.0.1:2861"

start_xray() {
  killall -TERM xray 2>/dev/null || true
  sleep 1
  XRAY_BIN=$(command -v xray || find /usr /etc /opt -name "xray" -type f 2>/dev/null | head -n 1)
  XRAY_CFG=$(find /etc/wdtt-xray /etc/wdtt /usr/local/etc/xray -name "*.json" -type f 2>/dev/null | head -n 1)
  if [ -n "$XRAY_BIN" ] && [ -n "$XRAY_CFG" ]; then
    chmod +x "$XRAY_BIN"
    "$XRAY_BIN" run -c "$XRAY_CFG" >/var/log/xray.log 2>&1 &
  fi
}

case "$ACTION" in
  is-active)
    case "$SERVICE" in
      *xray*)
        if pgrep -x "xray" >/dev/null 2>&1; then
          echo "active"
          exit 0
        else
          echo "inactive"
          exit 3
        fi
        ;;
      *)
        if curl -sf "http://${API}/health" >/dev/null 2>&1 || pgrep -f "wdtt-app" >/dev/null 2>&1; then
          echo "active"
          exit 0
        else
          echo "inactive"
          exit 3
        fi
        ;;
    esac
    ;;

  start|restart|reload)
    case "$SERVICE" in
      *xray*)
        start_xray
        exit 0
        ;;
      *)
        if curl -sf -X POST "http://${API}/admin/restart" >/dev/null 2>&1; then
          exit 0
        fi
        killall -TERM wdtt-app 2>/dev/null || true
        exit 0
        ;;
    esac
    ;;

  stop)
    case "$SERVICE" in
      *xray*)
        killall -TERM xray 2>/dev/null || true
        exit 0
        ;;
      *)
        exit 0
        ;;
    esac
    ;;

  status)
    case "$SERVICE" in
      *xray*)
        if pgrep -x "xray" >/dev/null 2>&1; then
          echo "Active: active (running)"
          exit 0
        else
          echo "Active: inactive (dead)"
          exit 3
        fi
        ;;
      *)
        if pgrep -f "wdtt-app" >/dev/null 2>&1; then
          echo "● wdtt.service - WDTT Server (Alpine wrapper)"
          echo "   Active: active (running)"
          exit 0
        else
          echo "● wdtt.service - WDTT Server (Alpine wrapper)"
          echo "   Active: inactive (dead)"
          exit 3
        fi
        ;;
    esac
    ;;

  *)
    exit 0
    ;;
esac
