#!/bin/sh

ACTION="$1"
SERVICE="$2"
API="127.0.0.1:2861"
XRAY_BIN="/usr/local/wdtt-xray/bin/xray"
XRAY_CFG="/etc/wdtt-xray/config.json"
XRAY_DISABLED_FLAG="/etc/wdtt-xray/disabled"

enable_xray_redirect() {
  iptables -t nat -C PREROUTING -s 10.66.66.0/24 -p tcp -j REDIRECT --to-ports 12345 2>/dev/null || \
  iptables -t nat -A PREROUTING -s 10.66.66.0/24 -p tcp -j REDIRECT --to-ports 12345
  iptables -t nat -C PREROUTING -s 10.70.0.0/16 -p tcp -j REDIRECT --to-ports 12345 2>/dev/null || \
  iptables -t nat -A PREROUTING -s 10.70.0.0/16 -p tcp -j REDIRECT --to-ports 12345
  iptables -C INPUT -p tcp --dport 12345 -j ACCEPT 2>/dev/null || \
  iptables -I INPUT -p tcp --dport 12345 -j ACCEPT
}

disable_xray_redirect() {
  iptables -t nat -D PREROUTING -s 10.66.66.0/24 -p tcp -j REDIRECT --to-ports 12345 2>/dev/null || true
  iptables -t nat -D PREROUTING -s 10.70.0.0/16 -p tcp -j REDIRECT --to-ports 12345 2>/dev/null || true
}

start_xray() {
  rm -f "$XRAY_DISABLED_FLAG"
  killall -TERM xray 2>/dev/null || true
  sleep 1
  if [ -x "$XRAY_BIN" ] && [ -f "$XRAY_CFG" ]; then
    awk '/"port": 12345/{sub(/127\.0\.0\.1/, "0.0.0.0", prev)} NR>1{print prev} {prev=$0} END{print prev}' "$XRAY_CFG" > /tmp/xray.json && mv /tmp/xray.json "$XRAY_CFG"
    mkdir -p /var/log/wdtt-xray
    "$XRAY_BIN" run -c "$XRAY_CFG" >/var/log/xray.log 2>&1 &
    enable_xray_redirect
  fi
}

case "$ACTION" in
  is-active)
    case "$SERVICE" in
      *xray*)
        if pgrep -f "$XRAY_BIN run" >/dev/null 2>&1; then
          echo "active"
          exit 0
        else
          echo "inactive"
          exit 3
        fi
        ;;
      *)
        if curl -sf "http://${API}/health" >/dev/null 2>&1 || pgrep -f "wdtt-app" >/dev/null 2>&1; then
          echo "active"
          exit 0
        else
          echo "inactive"
          exit 3
        fi
        ;;
    esac
    ;;

  start|restart|reload)
    case "$SERVICE" in
      *xray*)
        start_xray
        exit 0
        ;;
      *)
        if curl -sf -X POST "http://${API}/admin/restart" >/dev/null 2>&1; then
          exit 0
        fi
        killall -TERM wdtt-app 2>/dev/null || true
        exit 0
        ;;
    esac
    ;;

  stop)
    case "$SERVICE" in
      *xray*)
        touch "$XRAY_DISABLED_FLAG"
        disable_xray_redirect
        killall -TERM xray 2>/dev/null || true
        exit 0
        ;;
      *)
        exit 0
        ;;
    esac
    ;;

  status)
    case "$SERVICE" in
      *xray*)
        if pgrep -f "$XRAY_BIN run" >/dev/null 2>&1; then
          echo "Active: active (running)"
          exit 0
        else
          echo "Active: inactive (dead)"
          exit 3
        fi
        ;;
      *)
        if pgrep -f "wdtt-app" >/dev/null 2>&1; then
          echo "● wdtt.service - WDTT Server (Alpine wrapper)"
          echo "   Active: active (running)"
          exit 0
        else
          echo "● wdtt.service - WDTT Server (Alpine wrapper)"
          echo "   Active: inactive (dead)"
          exit 3
        fi
        ;;
    esac
    ;;

  *)
    exit 0
    ;;
esac
